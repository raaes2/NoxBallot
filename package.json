{
  "name": "nox-ballot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "compile": "node scripts/compile.cjs",
    "test": "cross-env NODE_OPTIONS='--experimental-vm-modules' vitest run",
    "test:local": "cross-env MIDNIGHT_NETWORK=local yarn test",
    "test:preview": "cross-env MIDNIGHT_NETWORK=preview yarn test",
    "test:preprod": "cross-env MIDNIGHT_NETWORK=preprod yarn test",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "copy:managed": "xcopy /E /I /Y contracts\\managed\\noxballot\\contract frontend\\src\\managed\\contract & xcopy /E /I /Y contracts\\managed\\noxballot frontend\\public\\managed"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.1.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "rxjs": "^7.8.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.9",
    "cross-env": "^10.1.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "resolutions": {
    "@midnight-ntwrk/ledger-v8": "8.1.2",
    "@midnight-ntwrk/onchain-runtime-v3": "3.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.1.0",
    "@midnight-ntwrk/zkir-v2": "2.1.1",
    "testcontainers": "12.0.4"
  },
  "packageManager": "yarn@1.22.22"
}
